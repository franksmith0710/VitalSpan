VITALSPAN_ENV=development
DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5432/vitalspan
# 可选：MySQL 8+ 平台元库（compose 服务 meta-mysql，宿主机 3309）
# DATABASE_URL=mysql://vitalspan:vitalspan@localhost:3309/vitalspan
# 可选：SQLite 单文件元库（开发/测试）
# DATABASE_URL=sqlite+pysqlite:///./data/vitalspan-meta.db
SECRET_KEY=change-me-in-production
# 本地开发须为合法 Fernet 密钥（解密遗留凭证）；生产环境务必重新生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_FERNET_KEY=REPLACE_WITH_FERNET_GENERATE_KEY
# 国密 SM4 凭证加密（固定算法）；32 位十六进制 = 16 字节密钥：
# python -c "import secrets; print(secrets.token_hex(16))"
CREDENTIAL_SM4_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
LOG_LEVEL=INFO
# 二期查询硬上限（M1 仅占位）
QUERY_DEFAULT_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
ANALYTICS_DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5433/analytics
# 样例源（文档注释，非 Settings 字段）
# SAMPLE_MYSQL_URL=mysql+pymysql://sample:sample@localhost:3307/sample_db
# SAMPLE_TIMESCALEDB_URL=postgresql+psycopg://vitalspan:vitalspan@127.0.0.1:5434/ops_tsdb
#   ↑ sample-timescaledb compose 服务；CONN-013 演示/集成测；与 analytics-postgres:5433 不同库
VITALSPAN_DEV_ADMIN_PASSWORD=changeme
# 报表调度投递（SMTP；本地可用 MailHog 1025）
RPT_SMTP_HOST=localhost
RPT_SMTP_PORT=1025
RPT_SMTP_FROM=reports@vitalspan.local
# 开发环境：幂等写入 demo 报表模板/预制/调度（须 VITALSPAN_ENV=development）
# DEV_REPORT_SEED=1

# 恢复数据库备份时须同时保管上述 SECRET_KEY / CREDENTIAL_* 密钥（见 scripts/backup-databases.py keys-checklist.txt）
