VITALSPAN_ENV=development
DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5432/vitalspanSECRET_KEY=change-me-in-production
CREDENTIAL_FERNET_KEY=change-me-32-byte-fernet-key-placeholder
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# 二期查询硬上限（M1 仅占位）
QUERY_DEFAULT_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
ANALYTICS_DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5433/analytics
