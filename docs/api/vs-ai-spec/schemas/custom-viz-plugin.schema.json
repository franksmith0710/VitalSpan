{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalspan.local/schemas/custom-viz-plugin.json",
  "title": "CustomVizArtifactCreate",
  "type": "object",
  "required": ["manifest", "files"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["id", "displayName", "entry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string" },
        "entry": { "type": "string", "default": "index.html" },
        "rendererHint": {
          "type": "string",
          "enum": ["d3", "vanilla", "canvas", "svg"],
          "description": "Optional metadata only; platform does not validate or enforce."
        },
        "fieldSlots": { "type": "object" },
        "styleSchema": { "type": "object" },
        "defaultStyle": { "type": "object" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 524288 }
    }
  }
}
