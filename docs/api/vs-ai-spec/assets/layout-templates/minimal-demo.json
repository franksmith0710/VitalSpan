{
  "id": "minimal-demo",
  "name": "极简演示",
  "description": "仅 5 块，大留白，适合 POC",
  "surfaceKind": "data-screen",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "styleConfig": {
    "surfaceKind": "data-screen",
    "colorScheme": "dark",
    "scaleMode": "canvas",
    "gapPreset": "md",
    "widgetGap": 16,
    "pixelGutter": 24,
    "canvasBackground": "#0b1020",
    "canvasBackgroundCustom": true,
    "canvasDecorPresetId": "gradient-radial",
    "refreshIntervalSec": 60,
    "widgetStyle": {
      "background": "rgba(15, 23, 42, 0.78)",
      "borderColor": "#818cf859",
      "borderWidth": 1,
      "borderEnabled": true,
      "borderStyle": "solid",
      "borderRadius": 10
    },
    "titleStyle": {
      "color": "#e2e8f0",
      "fontSize": 14,
      "fontWeight": 600
    },
    "chartLabelStyle": {
      "color": "#cbd5e1"
    }
  },
  "slots": [
    {
      "type": "chart",
      "title": "主 KPI",
      "x": 560,
      "y": 120,
      "width": 800,
      "height": 160,
      "defaultChartType": "kpi"
    },
    {
      "type": "chart",
      "title": "主图表",
      "x": 360,
      "y": 320,
      "width": 1200,
      "height": 360
    },
    {
      "type": "chart",
      "title": "辅图",
      "x": 760,
      "y": 700,
      "width": 400,
      "height": 160
    },
    {
      "type": "customViz",
      "title": "AI 组件 A",
      "x": 360,
      "y": 880,
      "width": 580,
      "height": 152
    },
    {
      "type": "customViz",
      "title": "AI 组件 B",
      "x": 980,
      "y": 880,
      "width": 580,
      "height": 152
    }
  ]
}