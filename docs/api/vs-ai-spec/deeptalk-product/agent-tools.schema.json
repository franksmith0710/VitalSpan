{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepTalk VitalSpan Agent Tools",
  "description": "DeepTalk VitalSpan Agent Tools. Primary: vitalspan plugin components.tools (Node fetch). Legacy dev/CI: integrations/vitalspan/executor/cli.py",
  "tools": [
    {
      "name": "vitalspan_health_check",
      "runtime": "plugin|cli",
      "description": "GET /health before workflow 2 or 3",
      "cli": "python executor/cli.py vitalspan_health_check",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "vitalspan_get_contract_card",
      "runtime": "plugin|cli",
      "description": "Workflow 2: return contract_card.json (底层规范，按需调用，不写入 prompt)",
      "cli": "python executor/cli.py vitalspan_get_contract_card",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "vitalspan_scaffold_artifact",
      "runtime": "plugin|cli",
      "description": "Workflow 2: scaffold customViz under examples/ (default generic-blank-*)",
      "cli": "python executor/cli.py vitalspan_scaffold_artifact --id {id} --name {name} --runtime {runtime}",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Bundle id slug" },
          "name": { "type": "string", "description": "Chinese display name" },
          "runtime": { "type": "string", "enum": ["html", "d3"], "default": "html" }
        },
        "required": ["id", "name"]
      }
    },
    {
      "name": "vitalspan_validate_artifact",
      "runtime": "plugin|cli",
      "description": "Workflow 2: preflight + structured fix/snippet JSON + validate stamp",
      "cli": "python executor/cli.py vitalspan_validate_artifact --file {file}",
      "parameters": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "Path under workspace, e.g. examples/my-widget.json" }
        },
        "required": ["file"]
      }
    },
    {
      "name": "vitalspan_publish_artifact",
      "runtime": "plugin|cli",
      "description": "Validate + POST/PUT customViz bundle to platform library. Completion requires ok artifactId= and styleComplianceTier=full in stdout.",
      "cli": "python executor/cli.py vitalspan_publish_artifact --file {file}",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path under vs-ai-spec, e.g. examples/my-widget.json"
          },
          "artifact_id": {
            "type": "string",
            "description": "Optional existing uuid for PUT update"
          }
        },
        "required": ["file"]
      }
    },
    {
      "name": "vitalspan_list_artifacts",
      "runtime": "plugin|cli",
      "description": "List current user's ai_viz artifacts",
      "cli": "python executor/cli.py vitalspan_list_artifacts",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 },
          "q": { "type": "string", "description": "Filter by manifest id or displayName" }
        }
      }
    },
    {
      "name": "vitalspan_delete_artifact",
      "runtime": "plugin|cli",
      "description": "DELETE artifact by id (owner only); returns 409 if still referenced by dashboards",
      "cli": "python executor/cli.py vitalspan_delete_artifact --artifact-id {artifact_id}",
      "parameters": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" }
        },
        "required": ["artifact_id"]
      }
    },
    {
      "name": "vitalspan_get_artifact",
      "runtime": "plugin|cli",
      "description": "Download full bundle to workspace examples/ for edit→validate→publish PUT",
      "cli": "python executor/cli.py vitalspan_get_artifact --artifact-id {artifact_id} --file {file}",
      "parameters": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" },
          "file": { "type": "string", "description": "Optional output path under workspace" }
        },
        "required": ["artifact_id"]
      }
    },
    {
      "name": "vitalspan_list_artifact_dashboard_refs",
      "runtime": "plugin|cli",
      "description": "List dashboards/data-screens referencing artifactId",
      "cli": "python executor/cli.py vitalspan_list_artifact_dashboard_refs --artifact-id {artifact_id}",
      "parameters": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" }
        },
        "required": ["artifact_id"]
      }
    },
    {
      "name": "vitalspan_delete_dashboard",
      "runtime": "plugin|cli",
      "description": "DELETE dashboard or data-screen by uuid",
      "cli": "python executor/cli.py vitalspan_delete_dashboard --dashboard-id {dashboard_id}",
      "parameters": {
        "type": "object",
        "properties": {
          "dashboard_id": { "type": "string" }
        },
        "required": ["dashboard_id"]
      }
    },
    {
      "name": "vitalspan_validate_chart_config",
      "runtime": "plugin|cli",
      "description": "Workflow 1: validate L1/L2 chartConfig via POST /charts/validate",
      "cli": "python executor/cli.py vitalspan_validate_chart_config --file {file}",
      "parameters": {
        "type": "object",
        "properties": {
          "file": { "type": "string" }
        },
        "required": ["file"]
      }
    },
    {
      "name": "vitalspan_route_request",
      "runtime": "plugin|cli",
      "description": "Rule-based wf1/wf2/wf3 routing from capability-routing.json",
      "cli": "python executor/cli.py vitalspan_route_request --text {text}",
      "parameters": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "User request in natural language" }
        },
        "required": ["text"]
      }
    },
    {
      "name": "vitalspan_list_layout_templates",
      "runtime": "plugin",
      "description": "Workflow 3: list 21 layout templates (5 de-* + 6 gov-* data-screen + 10 dash-*)",
      "parameters": {
        "type": "object",
        "properties": {
          "surface_kind": {
            "type": "string",
            "enum": ["dashboard", "data-screen"],
            "description": "Optional filter"
          }
        }
      }
    },
    {
      "name": "vitalspan_list_chart_types",
      "runtime": "plugin",
      "description": "Workflow 1/3: list built-in chartType ids",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "vitalspan_compose_dashboard",
      "runtime": "plugin",
      "description": "Workflow 3: create surface + save layout from template/chart_types/artifact_ids. Stdout must include ok dashboardId=.",
      "parameters": {
        "type": "object",
        "properties": {
          "surface_kind": {
            "type": "string",
            "enum": ["dashboard", "data-screen"],
            "description": "Required when creating new"
          },
          "dashboard_id": { "type": "string", "description": "Existing uuid to update" },
          "name": { "type": "string" },
          "template": { "type": "string", "description": "Layout template id from list_layout_templates" },
          "chart_types": { "type": "string", "description": "Comma-separated built-in types" },
          "artifact_ids": { "type": "string", "description": "Comma-separated customViz uuids" }
        }
      }
    },
    {
      "name": "vitalspan_get_dashboard_layout",
      "runtime": "plugin",
      "description": "Workflow 3: GET dashboard + write editor-save JSON for style-only patch",
      "parameters": {
        "type": "object",
        "properties": {
          "dashboard_id": { "type": "string" },
          "file": { "type": "string", "description": "Output path under workspace examples/" }
        },
        "required": ["dashboard_id", "file"]
      }
    },
    {
      "name": "vitalspan_create_dashboard",
      "runtime": "plugin",
      "description": "Create empty dashboard or data-screen (prefer compose_dashboard for workflow 3)",
      "parameters": {
        "type": "object",
        "properties": {
          "surface_kind": { "type": "string", "enum": ["dashboard", "data-screen"] },
          "name": { "type": "string" }
        },
        "required": ["surface_kind"]
      }
    },
    {
      "name": "vitalspan_list_dashboards",
      "runtime": "plugin",
      "description": "List dashboards and data-screens",
      "parameters": {
        "type": "object",
        "properties": {
          "surface_kind": { "type": "string", "enum": ["dashboard", "data-screen"] },
          "limit": { "type": "integer", "default": 100 }
        }
      }
    },
    {
      "name": "vitalspan_upload_dashboard",
      "runtime": "plugin|cli",
      "description": "Workflow 3: PUT dashboard editor-save layout from file or inline chart_types",
      "cli": "python executor/cli.py vitalspan_upload_dashboard --dashboard-id {dashboard_id} --file {file}",
      "parameters": {
        "type": "object",
        "properties": {
          "dashboard_id": { "type": "string" },
          "file": { "type": "string" },
          "chart_types": { "type": "string" },
          "artifact_ids": { "type": "string" }
        },
        "required": ["dashboard_id"]
      }
    },
    {
      "name": "vitalspan_completion_gate",
      "runtime": "plugin|cli",
      "description": "Reject completion without artifactId+tier=full (wf2) or compose/upload stdout with layout widgets (wf3)",
      "cli": "python executor/cli.py vitalspan_completion_gate --workflow {workflow} --agent-summary {agent_summary} --tool-stdout {tool_stdout}",
      "parameters": {
        "type": "object",
        "properties": {
          "workflow": {
            "type": "string",
            "enum": ["1", "2", "3"],
            "description": "1=builtin chart, 2=artifact, 3=dashboard"
          },
          "agent_summary": {
            "type": "string",
            "description": "Agent final message to validate"
          },
          "tool_stdout": {
            "type": "string",
            "description": "Required for workflow 2 (publish) and 3 (compose/upload) raw tool output"
          }
        },
        "required": ["workflow", "agent_summary"]
      }
    }
  ]
}
