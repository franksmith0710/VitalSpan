{
  "manifest": {
    "id": "alert-scroll-feed-v1",
    "displayName": "实时告警滚动条",
    "version": "1.0.0",
    "entry": "index.html",
    "fieldSlots": {
      "dimensions": {
        "min": 1,
        "max": 1,
        "label": "告警内容"
      },
      "metrics": {
        "min": 1,
        "max": 1,
        "label": "严重等级"
      }
    },
    "styleSchema": {
      "type": "object",
      "x-styleSections": [
        {
          "title": "滚动",
          "properties": [
            "scrollSpeed",
            "maxVisible"
          ]
        },
        {
          "title": "颜色",
          "properties": [
            "accentColor",
            "warnColor",
            "dangerColor"
          ]
        }
      ],
      "properties": {
        "scrollSpeed": {
          "type": "number",
          "minimum": 20,
          "maximum": 120,
          "title": "滚动速度（秒/轮）"
        },
        "maxVisible": {
          "type": "number",
          "minimum": 3,
          "maximum": 12,
          "title": "可见行数"
        },
        "accentColor": {
          "type": "string",
          "format": "color",
          "title": "信息色"
        },
        "warnColor": {
          "type": "string",
          "format": "color",
          "title": "警告色"
        },
        "dangerColor": {
          "type": "string",
          "format": "color",
          "title": "危险色"
        }
      }
    },
    "defaultStyle": {
      "scrollSpeed": 48,
      "maxVisible": 6,
      "accentColor": "#38bdf8",
      "warnColor": "#f59e0b",
      "dangerColor": "#ef4444"
    },
    "rendererHint": "vanilla"
  },
  "files": {
    "index.html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;background:transparent;color:var(--dashboard-text-primary,#e2e8f0);font-family:system-ui,sans-serif;overflow:hidden}#vs-cv-feed{height:100%;padding:10px 12px;box-sizing:border-box;display:flex;flex-direction:column;gap:6px}.hdr{font-size:13px;font-weight:600;color:var(--dashboard-title-color,#f2f4f7);padding-bottom:6px;border-bottom:1px solid var(--dashboard-widget-border,#344054)}.viewport{flex:1;overflow:hidden;position:relative}.track{position:absolute;left:0;right:0;animation:vsScroll var(--vs-style-scroll-speed,48s) linear infinite}@keyframes vsScroll{0%{transform:translateY(0)}100%{transform:translateY(-50%)}}.row{display:flex;align-items:center;gap:10px;padding:8px 10px;margin-bottom:6px;background:var(--dashboard-widget-surface,#1e293b);border-radius:6px;border-left:3px solid var(--vs-style-accent-color,#38bdf8)}.row.warn{border-left-color:var(--vs-style-warn-color,#f59e0b)}.row.danger{border-left-color:var(--vs-style-danger-color,#ef4444)}.badge{font-size:10px;padding:2px 6px;border-radius:4px;background:rgba(255,255,255,0.08);color:var(--dashboard-text-muted,#98a2b3);flex-shrink:0}.msg{font-size:12px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style></head><body><div id=\"vs-cv-feed\"><div class=\"hdr\">实时告警</div><div class=\"viewport\"><div class=\"track\" id=\"vs-cv-track\"></div></div></div><script>(function(){var DEMO=[{n:'数据库连接池接近上限',v:2},{n:'华东节点 CPU 使用率 92%',v:2},{n:'备份任务延迟 15 分钟',v:1},{n:'未授权访问尝试已拦截',v:3},{n:'磁盘 /data 使用率 88%',v:2},{n:'定时报表生成成功',v:0},{n:'API 网关 P99 延迟升高',v:2},{n:'证书 30 天内到期',v:1}];function readPayload(){var n=document.querySelector('.vs-cv-payload');if(!n||!n.textContent)return null;try{return JSON.parse(n.textContent)}catch(e){return null}}function rowsFromPayload(p){if(!p||!p.rows||!p.rows.length)return DEMO;var cols=p.columns||[];var di=cols.findIndex(function(c){return c!=='sum'&&c!=='count'});var mi=cols.findIndex(function(c,i){return i!==di});if(di<0)di=0;if(mi<0)mi=1;return p.rows.map(function(r){return{n:String(r[di]),v:Number(r[mi])||0}})}function levelClass(v){if(v>=3)return'danger';if(v>=2)return'warn';return''}function levelLabel(v){if(v>=3)return'严重';if(v>=2)return'警告';if(v>=1)return'提示';return'信息'}function render(){var track=document.getElementById('vs-cv-track');if(!track)return;var p=readPayload();var st=(p&&p.style)||{};var speed=Number(st.scrollSpeed)||48;track.style.setProperty('--vs-style-scroll-speed',speed+'s');var data=rowsFromPayload(p);var maxVis=Number(st.maxVisible)||6;var slice=data.slice(0,maxVis*2);track.innerHTML='';slice.concat(slice).forEach(function(d){var row=document.createElement('div');row.className='row '+levelClass(d.v);var badge=document.createElement('span');badge.className='badge';badge.textContent=levelLabel(d.v);row.appendChild(badge);var msg=document.createElement('span');msg.className='msg';msg.textContent=d.n;row.appendChild(msg);track.appendChild(row)})}render();var host=document.currentScript&&document.currentScript.parentElement;if(host&&host.classList.contains('vs-custom-viz-host')){host.addEventListener('vs-cv-payload-update',render)}})();</script></body></html>"
  }
}
