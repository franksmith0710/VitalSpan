{
  "manifest": {
    "id": "demo-ranking-strip",
    "displayName": "演示排名条",
    "version": "1.0.0",
    "entry": "index.html",
    "fieldSlots": {
      "dimensions": { "min": 1, "max": 1, "label": "类别" },
      "metrics": { "min": 1, "max": 1, "label": "数值" }
    },
    "styleSchema": {
      "type": "object",
      "properties": {
        "accentColor": { "type": "string", "format": "color", "title": "强调色" },
        "barHeight": { "type": "number", "minimum": 8, "maximum": 48, "title": "条高度" }
      }
    },
    "defaultStyle": { "accentColor": "#2563eb", "barHeight": 20 },
    "rendererHint": "vanilla"
  },
  "files": {
    "index.html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;background:#0f172a;color:#e2e8f0;font-family:system-ui,sans-serif}#vs-cv-root{padding:12px}.row{display:flex;align-items:center;gap:8px;margin:6px 0}.bar{height:var(--h,20px);background:var(--accent,#2563eb);border-radius:4px;min-width:4px}</style></head><body><div id=\"vs-cv-root\"></div><script>const data=[{n:\"华东\",v:92},{n:\"华南\",v:78},{n:\"华北\",v:65}];const max=Math.max(...data.map(d=>d.v));const root=document.getElementById(\"vs-cv-root\");data.forEach(d=>{const row=document.createElement(\"div\");row.className=\"row\";row.innerHTML=\"<span style=\\\"width:48px\\\">\"+d.n+\"</span><div class=\\\"bar\\\" style=\\\"width:\"+(d.v/max*100)+\"%;--h:20px\\\"></div><span>\"+d.v+\"</span>\";root.appendChild(row);});</script></body></html>"
  }
}
