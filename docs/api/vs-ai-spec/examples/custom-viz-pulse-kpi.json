{
  "manifest": {
    "id": "pulse-kpi-ribbon-v1",
    "displayName": "脉冲 KPI 指标带",
    "version": "1.0.0",
    "entry": "index.html",
    "fieldSlots": {
      "dimensions": {
        "min": 1,
        "max": 1,
        "label": "指标名称"
      },
      "metrics": {
        "min": 1,
        "max": 1,
        "label": "指标数值"
      }
    },
    "styleSchema": {
      "type": "object",
      "x-styleSections": [
        {
          "title": "外观",
          "properties": [
            "accentColor",
            "glowIntensity",
            "cardGap"
          ]
        },
        {
          "title": "标签",
          "properties": [
            "labelSize",
            "valueSize"
          ]
        }
      ],
      "properties": {
        "accentColor": {
          "type": "string",
          "format": "color",
          "title": "强调色"
        },
        "glowIntensity": {
          "type": "number",
          "minimum": 10,
          "maximum": 80,
          "title": "光晕强度",
          "step": 5
        },
        "cardGap": {
          "type": "number",
          "minimum": 4,
          "maximum": 32,
          "title": "卡片间距"
        },
        "labelSize": {
          "type": "number",
          "minimum": 10,
          "maximum": 18,
          "title": "标签字号"
        },
        "valueSize": {
          "type": "number",
          "minimum": 18,
          "maximum": 40,
          "title": "数值字号"
        }
      }
    },
    "defaultStyle": {
      "accentColor": "#38bdf8",
      "glowIntensity": 40,
      "cardGap": 12,
      "labelSize": 12,
      "valueSize": 28
    },
    "rendererHint": "vanilla"
  },
  "files": {
    "index.html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;background:transparent;color:var(--dashboard-text-primary,#e2e8f0);font-family:system-ui,sans-serif}#vs-cv-kpi{display:flex;gap:var(--vs-style-card-gap,12px);padding:12px;height:100%;box-sizing:border-box;align-items:stretch}.card{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:14px 10px;background:var(--dashboard-widget-surface,#1e293b);border:1px solid var(--dashboard-widget-border,#344054);border-radius:8px;position:relative;overflow:hidden;min-width:0}.card::before{content:'';position:absolute;inset:0;border-radius:8px;box-shadow:0 0 calc(var(--vs-style-glow-intensity,40)*1px) var(--vs-style-accent-color,#38bdf8);opacity:0.35;animation:vsPulse 2.4s ease-in-out infinite}@keyframes vsPulse{0%,100%{opacity:0.18}50%{opacity:0.55}}.lbl{font-size:calc(var(--vs-style-label-size,12)*1px);color:var(--dashboard-text-muted,#98a2b3);margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.val{font-size:calc(var(--vs-style-value-size,28)*1px);font-weight:700;color:var(--vs-style-accent-color,#38bdf8)}</style></head><body><div id=\"vs-cv-kpi\"></div><script>(function(){function readPayload(){var n=document.querySelector('.vs-cv-payload');if(!n||!n.textContent)return null;try{return JSON.parse(n.textContent)}catch(e){return null}}function rowsFromPayload(p){if(!p||!p.rows||!p.rows.length)return[{n:'在线设备',v:1284},{n:'今日告警',v:23},{n:'处理率',v:96},{n:'巡检完成',v:87}];var cols=p.columns||[];var di=cols.findIndex(function(c){return c!=='sum'&&c!=='count'});var mi=cols.findIndex(function(c,i){return i!==di});if(di<0)di=0;if(mi<0)mi=1;return p.rows.map(function(r){return{n:String(r[di]),v:Number(r[mi])||0}})}function render(){var root=document.getElementById('vs-cv-kpi');if(!root)return;var data=rowsFromPayload(readPayload());root.innerHTML='';data.slice(0,6).forEach(function(d){var c=document.createElement('div');c.className='card';var lbl=document.createElement('div');lbl.className='lbl';lbl.textContent=d.n;c.appendChild(lbl);var val=document.createElement('div');val.className='val';val.textContent=d.v;c.appendChild(val);root.appendChild(c)})}render();var host=document.currentScript&&document.currentScript.parentElement;if(host&&host.classList.contains('vs-custom-viz-host')){host.addEventListener('vs-cv-payload-update',render)}})();</script></body></html>"
  }
}
